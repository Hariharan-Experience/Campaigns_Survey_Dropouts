# Anthropic API key used to score each submission
ANTHROPIC_API_KEY=

# Repo to scan — https://github.com/<GITHUB_OWNER>/<GITHUB_REPO>
GITHUB_OWNER=Experience-org
GITHUB_REPO=hackathon-aug26

# Branches to skip when listing submissions (comma-separated, no spaces needed)
EXCLUDE_BRANCHES=main,develop,staging,master

# Port the backend serves on (frontend is served at GET /)
PORT=3000
